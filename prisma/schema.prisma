// StudyMate AI database schema.
// Configured with PostgreSQL for global cloud database access (Neon, Supabase, Railway, etc.).
// Enables users to log in from anywhere in the world and access their synchronized history.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---- Auth.js tables (required by @auth/prisma-adapter) ----
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  password      String?        // hashed password for email/password auth
  createdAt     DateTime       @default(now())
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  notes         Note[]
  documents     Document[]
  quizzes       Quiz[]
  studySessions StudySession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---- StudyMate data ----
// One AI Tutor chat. Shown on the History page.
model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  notes     Note[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String // "user" | "ai"
  content        String
  vote           String? // "up" | "down" | null
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// A saved study note. Can be written by hand or saved from a tutor answer.
model Note {
  id             String        @id @default(cuid())
  userId         String
  title          String
  content        String
  conversationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
}

// Uploaded study material: PDFs, notes, slides.
model Document {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // "Notes" | "Books" | "Slides"
  pages     String   // e.g. "24 pages"
  content   String   // Extracted text content from the file
  fileSize  Int?     // bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// AI Generated Quizzes from uploaded notes
model Quiz {
  id         String   @id @default(cuid())
  userId     String
  title      String
  documentId String?
  questions  String   // JSON string of array of questions [{question, options, correctIndex, explanation}]
  score      Int?     // Best score achieved
  total      Int      // Total number of questions
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// A scheduled study session for the planner page.
model StudySession {
  id        String   @id @default(cuid())
  userId    String
  subject   String   // e.g. "Mathematics"
  date      String   // ISO date string "YYYY-MM-DD"
  startTime String   // "HH:MM" 24-hour
  duration  Int      // minutes
  note      String   @default("")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
