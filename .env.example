# Copy to .env.local (Next.js) AND .env (Prisma CLI reads .env) — or just use one .env file.

# Cloud Database (PostgreSQL). Use a cloud Postgres URL so users can sign in from anywhere in the world:
# Examples:
# Neon (Pooled):   DATABASE_URL="postgresql://user:password@ep-cool-xyz-pooler.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Neon (Unpooled): DATABASE_URL_UNPOOLED="postgresql://user:password@ep-cool-xyz.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
# Supabase:        DATABASE_URL="postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres"
# Railway:         DATABASE_URL="postgresql://postgres:password@viaduct.proxy.rlwy.net:12345/railway"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Auth.js. Generate a secret with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Needed when self-hosting (not on Vercel)
AUTH_TRUST_HOST=true

# Google OAuth credentials (see README for the 2-minute setup)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI tutor — set at least one. With neither, the tutor returns a demo reply.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash-lite"
